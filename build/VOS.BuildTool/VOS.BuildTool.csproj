<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release tooling for build/build.ps1: deterministic package, signed manifest, verification. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VOS.BuildTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The exact code V-OS and V-Launcher use to verify releases. -->
    <Compile Include="..\..\src\VOS.Core\Updates\ReleaseManifest.cs" Link="Shared\ReleaseManifest.cs" />
    <Compile Include="..\..\src\VOS.Core\Updates\ReleaseKey.cs" Link="Shared\ReleaseKey.cs" />
  </ItemGroup>
</Project>
