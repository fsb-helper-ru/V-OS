<Project Sdk="Microsoft.NET.Sdk">
  <!-- V-Platform: Win32, COM and WinRT integrations. All OS access goes through here. -->
  <PropertyGroup>
    <TargetFramework>$(VosWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>VOS.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VOS.Core\VOS.Core.csproj" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Data.OleDb" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VOS.Tests" />
  </ItemGroup>
</Project>
